<!--
Name: QuickAssist

The category groups both bindings into their own section in the Key Bindings panel.
The display text of each binding is defined in localization.lua (BINDING_NAME_QUICKASSIST_*).
-->
<Bindings>

<Binding name="QUICKASSIST_LEARN" category="QuickAssist">
SimpleAssist_LearnAssist("target");
</Binding>

<Binding name="QUICKASSIST_ASSIST" category="QuickAssist">
SimpleAssist_DoAssist();
</Binding>

</Bindings>
